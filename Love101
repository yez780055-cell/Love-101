<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>爱你101遍</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            height: 100vh;
            background: linear-gradient(to bottom, #e8f5e9, #c8e6c9, #a5d6a7);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Microsoft YaHei', sans-serif;
            position: relative;
        }
        
        .container {
            text-align: center;
            z-index: 10;
            position: relative;
            padding: 2rem;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(5px);
        }
        
        h1 {
            font-size: 4rem;
            margin-bottom: 1.5rem;
            color: #2e7d32;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
        }
        
        .leaves-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
            overflow: hidden;
        }
        
        .leaf {
            position: absolute;
            pointer-events: none;
            animation: float 12s ease-in infinite;
            opacity: 0.8;
            color: #558b2f;
            font-size: 24px;
        }
        
        .leaf:nth-child(3n+1) {
            color: #689f38;
        }
        
        .leaf:nth-child(3n+2) {
            color: #33691e;
        }
        
        @keyframes float {
            0% {
                transform: translateY(100vh) rotate(0deg) scale(0);
                opacity: 0;
            }
            10% {
                opacity: 0.8;
            }
            90% {
                opacity: 0.6;
            }
            100% {
                transform: translateY(-100px) rotate(360deg) scale(1);
                opacity: 0;
            }
        }
        
        .counter {
            font-size: 1.5rem;
            color: #388e3c;
            margin-top: 2rem;
        }
        
        .heart {
            color: #ff5252;
            display: inline-block;
            margin: 0 5px;
            animation: heartbeat 1.5s infinite;
        }
        
        @keyframes heartbeat {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.1);
            }
        }
    </style>
</head>
<body>
    <div class="leaves-container" id="leaves"></div>
    
    <div class="container">
        <h1>爱你101遍</h1>
        <div class="counter"> <span id="count">0</span>/101 遍 <span class="heart">❤</span></div>
    </div>

    <script>
        // 创建叶子元素
        function createLeaves() {
            const leavesContainer = document.getElementById('leaves');
            const leafCount = 101;
            
            for (let i = 0; i < leafCount; i++) {
                const leaf = document.createElement('div');
                leaf.classList.add('leaf');
                leaf.innerHTML = '🍃';
                
                // 随机位置
                leaf.style.left = `${Math.random() * 100}vw`;
                
                // 随机延迟
                leaf.style.animationDelay = `${Math.random() * 12}s`;
                
                // 随机大小
                const size = Math.random() * 30 + 20;
                leaf.style.fontSize = `${size}px`;
                
                leavesContainer.appendChild(leaf);
            }
        }
        
        // 计数器动画
        function animateCounter() {
            const counter = document.getElementById('count');
            let count = 0;
            const interval = setInterval(() => {
                count++;
                counter.textContent = count;
                if (count >= 101) {
                    clearInterval(interval);
                }
            }, 50);
        }
        
        // 初始化
        window.onload = function() {
            createLeaves();
            setTimeout(animateCounter, 1000);
        };
    </script>
</body>
</html>
